DATABASE_URL=postgresql+asyncpg://transcriber:CHANGE_ME@192.168.1.32:5432/transcriber
# Standalone default. The voice-stack production overlay replaces this with
# http://wyoming-openai-gateway:8555/v1.
GATEWAY_BASE_URL=http://host.docker.internal:8555/v1
RECORDINGS_DIR=/data/recordings

# First account bootstrap. Change these before first startup.
DEFAULT_USERNAME=local
DEFAULT_PASSWORD=CHANGE_ME_NOW
DEFAULT_DISPLAY_NAME=Local user
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=true

DEFAULT_LANGUAGE=
DEFAULT_VOICE=en_GB-northern_english_male-medium
# Keep near-live chunk WAVs after a recording finishes (troubleshooting only).
KEEP_LIVE_CHUNK_AUDIO=false

# Admin-only local speaker diarization / voice recognition
SPEAKER_SERVICE_URL=http://speaker-analyzer:9000
# Leave SPEAKER_SWAP_URL empty for the voice-stack and standalone deployments.
# It is retained only for the legacy AI-stack/T4 integration.
SPEAKER_SWAP_URL=
SPEAKER_SWAP_MODEL=speaker_auto
SPEAKER_SWAP_KEY=
SPEAKER_RESTORE_PREVIOUS=true
SPEAKER_MATCH_THRESHOLD=0.78
HF_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
SPEAKER_DEVICE=cuda

# Meeting notes (Tools → Meeting notes & Open Notebook). Any OpenAI-compatible
# chat endpoint; e.g. llama.cpp on the V100:
#   llama-server -m model.gguf --host 0.0.0.0 --port 8080 -ngl 99 -c 32768 --jinja --alias meeting-llm
# Leave LLM_BASE_URL empty to disable notes.
LLM_BASE_URL=
LLM_MODEL=meeting-llm
LLM_API_KEY=
LLM_TEMPERATURE=0.2
# Match llama-server's -c. Long meetings are split into parts of LLM_CHUNK_TOKENS.
LLM_CONTEXT_TOKENS=32768
LLM_CHUNK_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=4096
# Sends chat_template_kwargs.enable_thinking=false (Qwen3-style reasoning models).
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_SECONDS=900
NOTES_TIMEZONE=Europe/London

# Open Notebook export. Use an address reachable from inside this container.
OPEN_NOTEBOOK_URL=
OPEN_NOTEBOOK_PASSWORD=
# Optional, e.g. notebook:abc123. Preselected in the export picker, which
# lists notebooks live from Open Notebook each time you export.
OPEN_NOTEBOOK_NOTEBOOK_ID=
OPEN_NOTEBOOK_EMBED=true
# Optional browser address of the Open Notebook UI, for the "Open in" link.
OPEN_NOTEBOOK_UI_URL=
